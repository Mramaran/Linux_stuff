#!/usr/bin/env python3
"""Windows-style touchpad edge motion for libinput/Wayland.

While exactly one finger slides into any edge of the touchpad and stays there,
the cursor keeps moving in that direction (also while dragging).

Safety:
  * The touchpad is only *read* (never grabbed), so libinput keeps handling
    taps, scrolling, gestures, drag lock and palm detection as before.
  * Motion is injected through a separate virtual mouse. If this program stops
    or crashes, the touchpad simply works as normal without edge motion.
  * Edge motion starts only if the finger moved into the edge from the inner
    area, so a palm or finger that lands on the edge never moves the cursor.
  * Two or more fingers (scrolling, swipes) always disable edge motion.
"""
import select
import sys
import time

import evdev
from evdev import ecodes as e

EDGE_FRACTION = 0.06   # outer 6% of each side counts as the edge
SPEED = 7.0            # pixels per tick at the very edge
MIN_SPEED = 3.0        # pixels per tick just inside the edge zone
TICK = 0.012           # seconds between injected moves (~83 Hz)

FINGER_TOOLS = {
    e.BTN_TOOL_FINGER: 1, e.BTN_TOOL_DOUBLETAP: 2, e.BTN_TOOL_TRIPLETAP: 3,
    e.BTN_TOOL_QUADTAP: 4, e.BTN_TOOL_QUINTTAP: 5,
}


def find_touchpad() -> evdev.InputDevice:
    for path in evdev.list_devices():
        dev = evdev.InputDevice(path)
        abs_codes = [c for c, _ in dev.capabilities().get(e.EV_ABS, [])]
        if "touchpad" in dev.name.lower() and e.ABS_MT_POSITION_X in abs_codes:
            return dev
        dev.close()
    sys.exit("touchpad-edge-motion: no touchpad found")


class EdgeMotion:
    def __init__(self, pad: evdev.InputDevice):
        self.pad = pad
        ax = pad.absinfo(e.ABS_MT_POSITION_X)
        ay = pad.absinfo(e.ABS_MT_POSITION_Y)
        self.xmin, self.xmax = ax.min, ax.max
        self.ymin, self.ymax = ay.min, ay.max
        self.mx = (ax.max - ax.min) * EDGE_FRACTION
        self.my = (ay.max - ay.min) * EDGE_FRACTION
        self.ui = evdev.UInput(
            {e.EV_REL: [e.REL_X, e.REL_Y], e.EV_KEY: [e.BTN_LEFT]},
            name="Touchpad Edge Motion (virtual)",
        )
        self.slot = 0
        self.touches = {}          # slot -> [x, y]
        self.fingers = 0           # from BTN_TOOL_* (reliable finger count)
        self.armed = False         # finger was seen in the inner area
        self.dir = (0.0, 0.0)

    def handle(self, ev) -> None:
        if ev.type == e.EV_ABS:
            if ev.code == e.ABS_MT_SLOT:
                self.slot = ev.value
            elif ev.code == e.ABS_MT_TRACKING_ID:
                if ev.value < 0:
                    self.touches.pop(self.slot, None)
                else:
                    self.touches[self.slot] = [None, None]
            elif ev.code == e.ABS_MT_POSITION_X and self.slot in self.touches:
                self.touches[self.slot][0] = ev.value
            elif ev.code == e.ABS_MT_POSITION_Y and self.slot in self.touches:
                self.touches[self.slot][1] = ev.value
        elif ev.type == e.EV_KEY and ev.code in FINGER_TOOLS:
            n = FINGER_TOOLS[ev.code]
            if ev.value:
                self.fingers = n
            elif self.fingers == n:
                self.fingers = 0
        elif ev.type == e.EV_SYN and ev.code == e.SYN_REPORT:
            self.update()

    def edge_dir(self, x: int, y: int):
        def axis(v, lo, hi, m):
            if v <= lo + m:
                return -(0.4 + 0.6 * min(1.0, (lo + m - v) / m))
            if v >= hi - m:
                return 0.4 + 0.6 * min(1.0, (v - (hi - m)) / m)
            return 0.0
        return (axis(x, self.xmin, self.xmax, self.mx),
                axis(y, self.ymin, self.ymax, self.my))

    def update(self) -> None:
        pts = [p for p in self.touches.values() if None not in p]
        if self.fingers != 1 or len(pts) != 1:
            self.armed, self.dir = False, (0.0, 0.0)
            return
        dx, dy = self.edge_dir(*pts[0])
        if dx == 0.0 and dy == 0.0:
            self.armed = True       # finger is in the inner area
            self.dir = (0.0, 0.0)
        elif self.armed:
            self.dir = (dx, dy)

    def tick(self) -> None:
        def step(f):
            if f == 0.0:
                return 0
            mag = MIN_SPEED + (SPEED - MIN_SPEED) * (abs(f) - 0.4) / 0.6
            return int(round(mag)) * (1 if f > 0 else -1)
        sx, sy = step(self.dir[0]), step(self.dir[1])
        if sx:
            self.ui.write(e.EV_REL, e.REL_X, sx)
        if sy:
            self.ui.write(e.EV_REL, e.REL_Y, sy)
        if sx or sy:
            self.ui.syn()

    def run(self) -> None:
        next_tick = time.monotonic()
        while True:
            active = self.dir != (0.0, 0.0)
            timeout = max(0.0, next_tick - time.monotonic()) if active else None
            r, _, _ = select.select([self.pad.fd], [], [], timeout)
            if r:
                for ev in self.pad.read():
                    self.handle(ev)
            now = time.monotonic()
            if self.dir != (0.0, 0.0):
                if now >= next_tick:
                    self.tick()
                    next_tick = now + TICK
            else:
                next_tick = now


if __name__ == "__main__":
    EdgeMotion(find_touchpad()).run()
