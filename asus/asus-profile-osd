#!/usr/bin/env python3
"""Show a KDE on-screen icon whenever the ASUS performance profile changes (Fn+F5)."""
import select
import subprocess

PROFILE = "/sys/firmware/acpi/platform_profile"
LABELS = {
    "quiet": ("battery-profile-powersave", "Silent mode"),
    "low-power": ("battery-profile-powersave", "Silent mode"),
    "balanced": ("battery-profile-balanced", "Balanced mode"),
    "performance": ("battery-profile-performance", "Performance mode"),
}


OUTPUT = "eDP-1"
QUIET_PROFILES = {"quiet", "low-power"}


def set_refresh(profile: str) -> None:
    """Quiet -> 60 Hz to save battery; Balanced/Performance -> 144 Hz."""
    rate = 60 if profile in QUIET_PROFILES else 144
    subprocess.run(
        ["kscreen-doctor", f"output.{OUTPUT}.mode.1920x1080@{rate}"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
    )


def show(profile: str) -> None:
    icon, text = LABELS.get(profile, ("battery-profile-balanced", profile.title()))
    subprocess.run(
        ["qdbus6", "org.kde.plasmashell", "/org/kde/osdService",
         "org.kde.osdService.showText", icon, text],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
    )


def main() -> None:
    with open(PROFILE) as f:
        poller = select.poll()
        poller.register(f, select.POLLPRI | select.POLLERR)
        last = f.read().strip()
        set_refresh(last)  # match the refresh rate to the profile at login
        while True:
            # sysfs_notify wakes us instantly; the 1s timeout is a safety fallback.
            poller.poll(1000)
            f.seek(0)
            current = f.read().strip()
            if current != last:
                last = current
                set_refresh(current)
                show(current)


if __name__ == "__main__":
    main()
